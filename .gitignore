# Parity fingerprints are machine-generated from whichever account you run against,
# and they contain that account's real figures -- contract number, capacity amounts,
# and every metric value rendered on every page. Regenerate them locally with
# `python tests/parity.py capture --out tests/baseline`; do not commit them.
tests/baseline/
tests/baseline_pre_refactor/
tests/after*/
tests/final*/

